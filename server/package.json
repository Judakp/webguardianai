{
  "name": "webguardian-server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && node --watch dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "start": "node dist/index.js",
    "prebuild": "npm run build --workspace=webguardian-shared",
    "pretypecheck": "npm run build --workspace=webguardian-shared"
  },
  "dependencies": {
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "multer": "^2.5.0",
    "webguardian-shared": "^0.1.0",
    "playwright": "^1.56.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  }
}
